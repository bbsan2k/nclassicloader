# Local builds, packages, extracted analysis, and private input images.
/.build/
/dist/
/analysis/
/SNES-Mini-Kernels/
/NES-Mini-Kernels/
/import-test-*/
/rust/target/
/target/

# Pinned upstream sources are acquired by scripts/bootstrap-portable.py.
/third_party/ares/
/third_party/SDL/
# Historical local checkout, no longer used by the Rust importer/app.
/third_party/zlib/

# Console content, firmware, imported resources, saves, and captures.
*.img
*.hsqs
*.squashfs
