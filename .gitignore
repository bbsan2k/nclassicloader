!rust/assets/fonts/Barlow-SemiBold.ttf

# Compiled outputs and local tooling state. OFL-licensed launcher TTFs are
# intentional source resources, not compiled application binaries.
*.app/
*.dSYM/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.rlib
*.rmeta
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
.idea/
.vscode/

# Apple signing material and local Xcode archives/results are never source.
*.p12
*.pfx
*.pem
*.key
*.mobileprovision
*.ipa
*.xcarchive/
*.xcresult/
*.xcuserdata/
*.xcuserstate
